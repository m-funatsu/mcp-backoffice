# AI-OS Production Environment Configuration
# Version: 1.0.0
# Last Updated: 2025-07-21

# ========================================
# Application Settings
# ========================================
NODE_ENV=production
APP_NAME="AI-Native Enterprise Operating System"
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0

# ========================================
# Database Configuration
# ========================================
DB_HOST=prod-db.ai-os.com
DB_PORT=5432
DB_NAME=aios_production
DB_USER=aios_app
DB_PASSWORD=${DB_PASSWORD} # Set via environment variable
DB_POOL_MIN=10
DB_POOL_MAX=100
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# TimescaleDB
TIMESCALE_ENABLED=true
TIMESCALE_CHUNK_INTERVAL=1 week
TIMESCALE_RETENTION_POLICY=2 years

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST=prod-redis.ai-os.com
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD} # Set via environment variable
REDIS_DB=0
REDIS_KEY_PREFIX=aios:
REDIS_ENABLE_TLS=true

# Cache Settings
CACHE_TTL_DEFAULT=3600 # 1 hour
CACHE_TTL_SESSION=86400 # 24 hours
CACHE_TTL_STATIC=604800 # 7 days

# ========================================
# Security Configuration
# ========================================
JWT_SECRET=${JWT_SECRET} # Set via environment variable
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

BCRYPT_ROUNDS=12
SESSION_SECRET=${SESSION_SECRET} # Set via environment variable
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=strict

# CORS
CORS_ORIGIN=https://app.ai-os.com,https://www.ai-os.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# ========================================
# AI/ML Configuration
# ========================================
ML_API_ENDPOINT=https://ml.ai-os.com
ML_API_KEY=${ML_API_KEY} # Set via environment variable
ML_MODEL_VERSION=2.0.0
ML_TIMEOUT=30000 # 30 seconds

# OpenAI/Claude Integration
LLM_PROVIDER=claude
LLM_API_KEY=${LLM_API_KEY} # Set via environment variable
LLM_MODEL=claude-3-opus-20240229
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ========================================
# External Service Integrations
# ========================================
# Accounting Systems
FREEE_API_KEY=${FREEE_API_KEY}
FREEE_API_ENDPOINT=https://api.freee.co.jp
MONEYFORWARD_API_KEY=${MONEYFORWARD_API_KEY}
MONEYFORWARD_API_ENDPOINT=https://api.moneyforward.com

# Communication
SLACK_BOT_TOKEN=${SLACK_BOT_TOKEN}
SLACK_SIGNING_SECRET=${SLACK_SIGNING_SECRET}
TEAMS_WEBHOOK_URL=${TEAMS_WEBHOOK_URL}

# Storage
AWS_S3_BUCKET=aios-production
AWS_S3_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}

# ========================================
# Monitoring & Logging
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/aios/app.log
LOG_MAX_SIZE=100M
LOG_MAX_FILES=30
LOG_COMPRESS=true

# Error Tracking
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_ENABLED=true
GRAFANA_URL=https://metrics.ai-os.com

# Health Check
HEALTH_CHECK_INTERVAL=30000 # 30 seconds
HEALTH_CHECK_TIMEOUT=5000 # 5 seconds

# ========================================
# Performance Configuration
# ========================================
# Worker Settings
CLUSTER_ENABLED=true
WORKER_COUNT=0 # 0 = number of CPU cores
WORKER_MEMORY_LIMIT=2048 # MB

# Request Settings
REQUEST_TIMEOUT=30000 # 30 seconds
UPLOAD_LIMIT=50mb
JSON_LIMIT=10mb

# Database Optimization
DB_STATEMENT_TIMEOUT=30000 # 30 seconds
DB_QUERY_TIMEOUT=10000 # 10 seconds
DB_CONNECTION_TIMEOUT=5000 # 5 seconds

# ========================================
# Feature Flags
# ========================================
FEATURE_AI_AGENTS=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_MULTI_TENANT=true
FEATURE_REAL_TIME_SYNC=true
FEATURE_ADVANCED_REPORTING=true

# ========================================
# Compliance & Audit
# ========================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555 # 7 years
DATA_ENCRYPTION_AT_REST=true
DATA_ANONYMIZATION_ENABLED=true
GDPR_COMPLIANCE_MODE=true

# ========================================
# Backup Configuration
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *" # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=aios-backups
BACKUP_ENCRYPTION_KEY=${BACKUP_ENCRYPTION_KEY}

# ========================================
# Email Configuration
# ========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=${SMTP_PASSWORD}
EMAIL_FROM="AI-OS <noreply@ai-os.com>"
EMAIL_REPLY_TO=support@ai-os.com

# ========================================
# Webhook Configuration
# ========================================
WEBHOOK_TIMEOUT=10000 # 10 seconds
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000 # 5 seconds
WEBHOOK_SIGNATURE_SECRET=${WEBHOOK_SIGNATURE_SECRET}

# ========================================
# Agent Configuration
# ========================================
AGENT_EXECUTION_TIMEOUT=300000 # 5 minutes
AGENT_MAX_CONCURRENT_TASKS=50
AGENT_RETRY_ATTEMPTS=3
AGENT_COMMUNICATION_PROTOCOL=grpc

# ========================================
# System Limits
# ========================================
MAX_EMPLOYEES_PER_COMPANY=10000
MAX_API_CALLS_PER_MINUTE=1000
MAX_EXPORT_ROWS=100000
MAX_IMPORT_FILE_SIZE=100MB
MAX_CONCURRENT_EXPORTS=10

# ========================================
# CDN & Static Assets
# ========================================
CDN_ENABLED=true
CDN_URL=https://cdn.ai-os.com
STATIC_ASSETS_VERSION=1.0.0
ASSETS_CACHE_MAX_AGE=31536000 # 1 year

# ========================================
# Geographic Settings
# ========================================
DEFAULT_TIMEZONE=Asia/Tokyo
DEFAULT_LOCALE=ja-JP
DEFAULT_CURRENCY=JPY
SUPPORTED_LOCALES=ja-JP,en-US,zh-CN,ko-KR

# ========================================
# Legal & Compliance URLs
# ========================================
TERMS_OF_SERVICE_URL=https://www.ai-os.com/terms
PRIVACY_POLICY_URL=https://www.ai-os.com/privacy
SLA_URL=https://www.ai-os.com/sla
SUPPORT_URL=https://support.ai-os.com

# ========================================
# DO NOT COMMIT ACTUAL SECRETS
# Use environment variables or secret management service
# ========================================