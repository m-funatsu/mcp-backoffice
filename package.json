{
  "name": "ai-native-strategic-platform",
  "version": "2.1.0",
  "description": "AI-Native Strategic Platform for HR, Finance, and Business Intelligence with predictive analytics",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "api": "tsx src/api-server.ts",
    "console": "cd src/v3.2.0/enterprise-console && npm run dev",
    "client": "tsx src/client.ts",
    "cli": "tsx src/cli.ts",
    "init-db": "node -e \"import('./dist/database.js').then(m => m.initializeDatabase())\"",
    "migrate": "tsx src/migrate.ts",
    "test-data": "tsx src/test-data.ts",
    "test": "vitest",
    "test:unit": "vitest tests/unit",
    "test:integration": "vitest tests/integration",
    "test:security": "vitest tests/security",
    "test:e2e": "vitest tests/e2e",
    "test:coverage": "vitest --coverage",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "postgres:start": "docker-compose -f docker-compose.simple.yml up -d",
    "postgres:stop": "docker-compose -f docker-compose.simple.yml down",
    "postgres:reset": "docker-compose -f docker-compose.simple.yml down -v && docker-compose -f docker-compose.simple.yml up -d",
    "postgres:init": "tsx scripts/init-postgresql.ts",
    "db:setup": "npm run postgres:start && sleep 10 && npm run postgres:init",
    "pgadmin:start": "docker-compose --profile gui up -d pgadmin",
    "pgadmin:stop": "docker-compose stop pgadmin",
    "db:gui": "npm run pgadmin:start && echo 'pgAdmin available at http://localhost:8080 (admin@example.com / admin)'",
    "db:init": "tsx scripts/init-database.ts",
    "db-view": "tsx src/database-viewer.ts",
    "db-view:structure": "tsx src/database-viewer.ts structure",
    "db-view:data": "tsx src/database-viewer.ts data",
    "db-view:stats": "tsx src/database-viewer.ts stats",
    "db-view:all": "tsx src/database-viewer.ts all",
    "sample-data": "tsx src/sample-data-generator.ts",
    "console:dev": "vite --config src/v3.2.0/enterprise-console/vite.config.ts",
    "console:build": "vite build --config src/v3.2.0/enterprise-console/vite.config.ts",
    "console:preview": "vite preview --config src/v3.2.0/enterprise-console/vite.config.ts",
    "settings:dev": "vite --config src/settings/vite.config.ts",
    "settings:build": "vite build --config src/settings/vite.config.ts",
    "settings:preview": "vite preview --config src/settings/vite.config.ts",
    "api:dev": "tsx watch src/api-server.ts",
    "api:start": "tsx src/api-server.ts",
    "dev:all": "concurrently \"npm run console:dev\" \"npm run api:dev\"",
    "lint": "eslint 'src/**/*.{ts,tsx}' --cache --cache-location .eslintcache --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix --cache --cache-location .eslintcache",
    "lint:strict": "eslint 'src/**/*.{ts,tsx}' --config .eslintrc.json --max-warnings 0 --cache",
    "lint:watch": "eslint 'src/**/*.{ts,tsx}' --cache --watch",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,js,jsx,json,md}'",
    "typecheck": "tsc --noEmit --pretty",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json --pretty",
    "typecheck:watch": "tsc --noEmit --watch --pretty",
    "typecheck:build": "tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo",
    "precommit": "npm run typecheck:strict && npm run lint:strict && npm run format:check && npm run test:unit",
    "validate": "npm run typecheck:strict && npm run lint:strict && npm run test",
    "validate:full": "npm run clean && npm run typecheck:strict && npm run lint:strict && npm run format:check && npm run test:coverage",
    "clean": "rimraf dist .eslintcache .tsbuildinfo coverage",
    "clean:all": "npm run clean && rimraf node_modules package-lock.json",
    "type:coverage": "tsx scripts/check-type-coverage.ts",
    "type:coverage:csv": "tsx scripts/check-type-coverage.ts --csv"
  },
  "keywords": [
    "mcp",
    "ai-native",
    "strategic-platform",
    "hr-analytics",
    "predictive-analytics",
    "human-capital",
    "finance-automation",
    "business-intelligence",
    "japanese-labor-law",
    "ai-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/sdk": "^0.6.0",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/x-date-pickers": "^8.9.0",
    "@types/pg": "^8.15.4",
    "bcrypt": "^5.1.1",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^1.0.4",
    "eslint-plugin-unicorn": "^54.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.7.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.3.3",
    "vite": "^7.0.5",
    "vitest": "^1.6.1"
  }
}
