","fix":"69050","desc":"64254"},[3632,4261],"const query = `\n      WITH partitioned_data AS (\n        SELECT \n          ${groupBy.join(', ')},\n          ${Object.entries(aggregations).map(([alias, expr]) => `${expr} as ${alias}`).join(', ')},\n          ROW_NUMBER() OVER (PARTITION BY ${groupBy.join(', ')} ORDER BY ${groupBy[0]}) as rn\n        FROM ${baseTable}\n        ${filters ? 'WHERE ' + Object.entries(filters).map(([key, value], i) => `${key} = $${i + 1}`).join(' AND ') : ''}\n      )\n      SELECT \n        ${groupBy.join(', ')},\n        ${Object.keys(aggregations).join(', ')}\n      FROM partitioned_data\n      WHERE rn = 1\n      GROUP BY ${groupBy.join(', ')}\n    `;",{"messageId":"63881","fix":"69051","desc":"63883"},[3968,4063],"`WHERE ${  Object.entries(filters).map(([key, value], i) => `${key} = $${i + 1}`).join(' AND ')}`",{"messageId":"63881","fix":"69052","desc":"63883"},[4474,4503],"/**\n   * インデックスヒント付きクエリ\n   * @param table\n   * @param indexName\n   * @param selectColumns\n   */",[4474,4503],"/**\n   * インデックスヒント付きクエリ\n   * @param table\n   * @param indexName\n   * @param selectColumns\n   * @param table\n   * @param indexName\n   * @param selectColumns\n   */",[4474,4503],"/**\n   * インデックスヒント付きクエリ\n   * @param table\n   * @param indexName\n   * @param selectColumns\n   * @param table\n   * @param indexName\n   * @param selectColumns\n   * @param table\n   * @param indexName\n   * @param selectColumns\n   */",[4590,4612],{"messageId":"64249","fix":"69053","desc":"64251"},{"messageId":"64252","fix":"69054","desc":"64254"},{"messageId":"64249","fix":"69055","desc":"64251"},{"messageId":"64252","fix":"69056","desc":"64254"},[5407,5437],"/**\n   * パフォーマンスプロファイリング\n   * @param name\n   * @param fn\n   */",[5407,5437],"/**\n   * パフォーマンスプロファイリング\n   * @param name\n   * @param fn\n   * @param name\n   * @param fn\n   */",{"messageId":"64249","fix":"69057","desc":"64251"},{"messageId":"64252","fix":"69058","desc":"64254"},{"messageId":"64010","fix":