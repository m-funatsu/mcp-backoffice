73"],["60674","60675","60676"],{"range":"60677","text":"46700"},["60678"],["60679","60680","60681"],["60682"],{"range":"60683","text":"60684"},["60685"],"Arrow function has a complexity of 21. Maximum allowed is 10.","Refactor this function to reduce its Cognitive Complexity from 26 to the 8 allowed.",["60686","60687"],{"range":"60688","text":"60689"},["60690"],{"range":"60691","text":"46702"},{"range":"60692","text":"60693"},{"range":"60694","text":"60695"},{"range":"60696","text":"60697"},{"range":"60698","text":"60699"},{"range":"60700","text":"60701"},{"range":"60702","text":"60703"},"`onKeyPress` is deprecated. Use `onKeyUp` or `onKeyDown` instead",["60704","60705"],{"range":"60706","text":"46702"},["60707","60708","60709"],{"range":"60710","text":"60711"},{"range":"60712","text":"60713"},"`@mui/material` import should occur after import of `@mui/icons-material`",{"range":"60714","text":"60715"},"'SearchIcon' is defined but never used.","'DateRangeIcon' is defined but never used.","`@mui/x-date-pickers/DateTimePicker` import should occur after import of `@mui/x-date-pickers/AdapterDateFns`",{"range":"60716","text":"60717"},{"range":"60718","text":"60524"},{"range":"60719","text":"46324"},{"range":"60720","text":"46322"},"`../types` import should occur after import of `../services/AuditLogService`",{"range":"60721","text":"60722"},"Using exported name 'AuditLogService' as identifier for default import.",{"range":"60723","text":"46432"},"'loading' is assigned a value but never used.",["60724"],"Unsafe array destructuring of a tuple element with an error typed value.",["60725","60726"],"React Hook useEffect has a missing dependency: 'loadLogs'. Either include it or remove the dependency array.",["60727"],["60728","60729"],{"range":"60730","text":"60731"},{"range":"60732","text":"60733"},{"range":"60734","text":"60735"},{"range":"60736","text":"60737"},["60738","60739"],{"range":"60740","text":"60741"},["60742"],{"range":"60743","text":"60744"},{"range":"60745","te